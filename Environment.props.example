<?xml version="1.0" encoding="utf-8"?>
<!-- Machine-specific paths. Copy to Environment.props and adjust. Imported by Directory.Build.props. -->
<Project>
  <PropertyGroup>
    <VALHEIM_INSTALL>/path/to/Valheim</VALHEIM_INSTALL>
    <BEPINEX_PATH>$(VALHEIM_INSTALL)/BepInEx</BEPINEX_PATH>
    <VALHEIM_MANAGED>$(VALHEIM_INSTALL)/valheim_Data/Managed</VALHEIM_MANAGED>
    <!-- Optional: a folder the built plugin is copied to after every build. -->
    <!-- <MOD_DEPLOYPATH>/path/to/Valheim/BepInEx/plugins/QuickFill</MOD_DEPLOYPATH> -->
  </PropertyGroup>
</Project>
